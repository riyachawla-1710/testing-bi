# Set these in Cube Cloud -> Settings -> Environment variables.
# cube.py reads them; nothing here is committed with real values.
#
# PostgreSQL / AlloyDB is the ONLY data source. There is no Snowflake block -
# see the comment at the top of cube.py.

# Use the PUBLIC endpoint here. Cube Cloud is outside your VPC and cannot
# route to the private address.
PG_HOST=34.130.23.251
PG_PORT=5432
PG_DATABASE=<database>
PG_USER=cube_reader          # create a dedicated read-only role
PG_PASSWORD=
PG_SSL=true
PG_MAX_POOL=8
