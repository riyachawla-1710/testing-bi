# Set these in Cube Cloud -> Settings -> Environment variables.
# cube.py reads them; nothing here is committed with real values.

# --- PostgreSQL / AlloyDB read pool (the default data source) ---------------
PG_HOST=<alloydb-read-pool-private-ip>
PG_PORT=5432
PG_DATABASE=<database>
PG_USER=cube_reader          # create a dedicated read-only role
PG_PASSWORD=
PG_SSL=true
PG_MAX_POOL=8

# --- Snowflake (reference only, delete once the port is validated) ----------
SNOWFLAKE_ACCOUNT=charger-prod
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=BI
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=DATA_ENGINEER
